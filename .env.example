# Copy to .env and fill in. Never commit real values.

# ---- API ----
NODE_ENV=development
PORT=4000
# LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 on Render/Railway) so req.ip is correct
TRUST_PROXY=0

# MongoDB Atlas connection string (database name in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/innovexa?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_MINUTES=60
BCRYPT_ROUNDS=12

# Cookies: COOKIE_SECURE=true in production; COOKIE_DOMAIN=.innovexadigital.com when web and API are on subdomains
COOKIE_SECURE=false
# COOKIE_DOMAIN=
# auto (default): SameSite=None for secure sign-ins from an allowed origin on another host
# (e.g. two *.vercel.app domains), otherwise Lax. Or force lax | strict | none (none needs COOKIE_SECURE=true).
# COOKIE_SAMESITE=auto

# Web app base URL used in email links, and allowed browser origins (comma-separated)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional: also allow one Vercel project's preview deployments, as <project-name>:<team-slug>
# (matches only https://<project>-<hash>-<team>.vercel.app and https://<project>-git-<branch>-<team>.vercel.app)
# CORS_VERCEL_PREVIEWS=
RATE_LIMIT_ENABLED=true

# Email: smtp (real delivery) | log (dev: nothing sent, links redacted) | memory (tests)
EMAIL_TRANSPORT=log
# Display name shown to recipients. With Gmail the address part is replaced by SENDER_EMAIL.
EMAIL_FROM="Innovexa Digital <no-reply@innovexadigital.com>"
# Gmail: turn on 2-Step Verification, then create an App Password (Google Account > Security > App passwords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SENDER_EMAIL=you@gmail.com
# SENDER_PASSWORD=your-16-char-app-password
# (SMTP_USER / SMTP_PASS are still accepted as fallbacks)

# Seed script only (development). If unset, a random password is generated and printed.
# SEED_PASSWORD=

# Development admin created by `npm run seed:admin` (refuses to run in production)
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_PASSWORD=

# ---- Web (Vite) ----
# In dev/preview Vite proxies /api to the API (API_PROXY_TARGET, default http://localhost:4000).
# In production set the full API URL, e.g. https://api.innovexadigital.com/api/v1
VITE_API_URL=/api/v1
# Live updates over Socket.IO. Set to false when the API runs on serverless hosting (Vercel), which has no socket server.
# VITE_REALTIME=true

# ---- Files, payments, background jobs ----
# Local upload folder (relative to apps/api). Swap for object storage in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Online payments are disabled until all three Razorpay values are set (use test keys in development).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Deadline and payment reminders every 30 minutes
JOBS_ENABLED=true

# General API requests per IP per 15 minutes (sign-in/token endpoints have stricter limits)
# RATE_LIMIT_PER_15_MIN=3000

# Public https URL of the logo shown in emails (defaults to APP_URL/innovex.logo.jpeg; required to be https in production)
# EMAIL_LOGO_URL=https://app.innovexadigital.com/innovex.logo.jpeg

# Vercel Cron: bearer secret for /api/v1/internal/cron/* (at least 16 chars). Unset = cron routes disabled.
# CRON_SECRET=
