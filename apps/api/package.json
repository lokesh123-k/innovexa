{
  "name": "@innovexa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "seed:admin": "tsx --env-file-if-exists=../../.env scripts/seed-admin.ts",
    "email:test": "tsx --env-file-if-exists=../../.env scripts/email-test.ts"
  },
  "dependencies": {
    "@innovexa/shared": "0.1.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "mailparser": "^3.14.1",
    "mongodb-memory-server": "^10.2.3",
    "pino-pretty": "^13.1.1",
    "smtp-server": "^3.21.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
