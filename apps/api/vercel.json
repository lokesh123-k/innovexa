{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "cd ../.. && MONGOMS_DISABLE_POSTINSTALL=1 npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run build -w @innovexa/shared && npm run typecheck -w @innovexa/api",
  "crons": [{ "path": "/api/v1/internal/cron/reminders", "schedule": "0 3 * * *" }]
}
